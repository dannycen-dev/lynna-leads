{
  "name": "@lynna/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "wrangler": "wrangler",
    "typegen": "wrangler types --strict-vars=false",
    "typecheck": "tsc",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:seed:local": "wrangler d1 execute DB --local --file=seed/cum.sql",
    "user:create": "node scripts/create-user.mjs",
    "wa:account": "node scripts/wa-account.mjs"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.3",
    "hono": "^4.13.13",
    "pdf-lib": "1.17.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "drizzle-kit": "^0.31.11",
    "typescript": "5.9.3",
    "vitest": "4.1.11",
    "wrangler": "4.147.0"
  }
}
